t></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="procedures_defnoreturn" id="blk_ms" x="-2600" y="280"><field name="NAME">func_WaitStartKey</field><statement name="STACK"><block type="annotation" id="blk_mt"><field name="text">等待按下主板的 Start(确认)键 1 再继续（如果你的车没有该按键，改用 func_WaitTouch）。</field><next><block type="while_cmp" id="blk_mu"><value name="bool"><block type="math_compare" id="blk_mv"><field name="comparison_operator">==</field><value name="A"><block type="get_key" id="blk_mw"><field name="port">1</field></block></value><value name="B"><block type="math_number" id="blk_mx"><field name="NUM">1</field></block></value></block></value><statement name="code"><block type="wait" id="blk_my"><value name="time"><block type="math_number" id="blk_mz"><field name="NUM">0.02</field></block></value></block></statement><next><block type="wait" id="blk_mA"><value name="time"><block type="math_number" id="blk_mB"><field name="NUM">0.2</field></block></value></block></next></block></next></block></statement></block><block type="procedures_defnoreturn" id="blk_mC" x="-2140" y="280"><field name="NAME">func_WaitTouch</field><statement name="STACK"><block type="annotation" id="blk_mD"><field name="text">等待触碰传感器（端口1）被按下再继续；主程序.py 就是用触碰1当启动/分段键。</field><next><block type="while_cmp" id="blk_mE"><value name="bool"><block type="math_compare" id="blk_mF"><field name="comparison_operator">==</field><value name="A"><block type="getai_touch" id="blk_mG"><field name="channel">1</field></block></value><value name="B"><block type="math_number" id="blk_mH"><field name="NUM">1</field></block></value></block></value><statement name="code"><block type="wait" id="blk_mI"><value name="time"><block type="math_number" id="blk_mJ"><field name="NUM">0.02</field></block></value></block></statement><next><block type="wait" id="blk_mK"><value name="time"><block type="math_number" id="blk_mL"><field name="NUM">0.2</field></block></value></block></next></block></next></block></statement></block><block type="procedures_defnoreturn" id="blk_mM" x="-1680" y="280"><mutation><arg name="text" varid="v_27_text"></arg></mutation><field name="NAME">func_Show</field><statement name="STACK"><block type="annotation" id="blk_mN"><field name="text">在机器人屏幕显示一段文字（text 里放一个文本块）。</field><next><block type="printf" id="blk_mO"><value name="para1"><block type="variables_get" id="blk_mP"><field name="VAR" id="v_27_text" variabletype="">text</field></block></value></block></next></block></statement></block><block type="procedures_defnoreturn" id="blk_mQ" x="-1220" y="280"><field name="NAME">func_Beep</field><statement name="STACK"><block type="annotation" id="blk_mR"><field name="text">播放内置提示音（打招呼声）。</field><next><block type="play_sound" id="blk_mS"><field name="musicname">dazhaohu_c0.mp3</field></block></next></block></statement></block></xml>
